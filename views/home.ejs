<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>For You 💕</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --cream: #fdf6f0;
      --blush: #fce4ec;
      --pink: #f48fb1;
      --pastel-red: #e57373;
      --rose-deep: #c2185b;
      --gold: #d4af37;
      --gold-bright: #ffe082;
      --wood-light: #9c6644;
      --wood-mid: #7f4f24;
      --wood-dark: #582f0e;
      --text-ink: #4a282d;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #1a0b10;
      font-family: 'Cormorant Garamond', serif;
    }

    .stage {
      position: relative;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at 50% 30%, #ffebee 0%, #ffd1dc 45%, #f8bbd0 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      perspective: 1600px;
      overflow: hidden;
    }

    /* Ambient Glow & Sparkles */
    .warmth {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(255, 235, 179, 0.45) 0%, rgba(244, 143, 177, 0.2) 50%, transparent 80%);
      opacity: 0;
      transition: opacity 2.5s ease;
      pointer-events: none;
      z-index: 1;
    }
    .stage.opened .warmth { opacity: 1; }

    .bokeh, .hearts-field {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 2;
    }

    .bokeh span {
      position: absolute;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,0.9), rgba(255, 224, 130, 0.3) 60%, transparent 70%);
      filter: blur(2px);
      animation: float-bokeh 8s ease-in-out infinite alternate;
    }
    @keyframes float-bokeh {
      0% { transform: translateY(0) scale(0.9); opacity: 0.3; }
      100% { transform: translateY(-30px) scale(1.15); opacity: 0.8; }
    }

    .heart-particle {
      position: absolute;
      bottom: -40px;
      font-size: 1.1rem;
      color: var(--pink);
      opacity: 0;
      animation: float-heart linear infinite;
      text-shadow: 0 0 10px rgba(244, 143, 177, 0.8);
      user-select: none;
    }
    @keyframes float-heart {
      0% { transform: translateY(0) scale(0.6) rotate(0deg); opacity: 0; }
      15% { opacity: 0.8; }
      90% { opacity: 0.8; }
      100% { transform: translateY(-110vh) scale(1.2) rotate(35deg); opacity: 0; }
    }

    /* 3D Arch & Wooden Gate */
    .gate-wrap {
      position: relative;
      width: min(88vw, 560px);
      height: min(80vh, 680px);
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.8s ease;
    }

    /* CRITICAL FIX: Pass clicks straight through opened doors & frame */
    .stage.opened .gate-wrap,
    .stage.opened .gate-wrap * {
      pointer-events: none !important;
    }

    .arch-frame {
      position: absolute;
      inset: -14px;
      border: 8px solid rgba(255, 255, 255, 0.4);
      border-radius: 280px 280px 16px 16px;
      box-shadow: 0 12px 35px rgba(88, 47, 14, 0.25), inset 0 0 20px rgba(255,255,255,0.3);
      pointer-events: none;
      z-index: 7;
    }

    .gate {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      border-radius: 260px 260px 12px 12px;
      transform-style: preserve-3d;
    }

    .leaf {
      position: relative;
      width: 50%;
      height: 100%;
      background: repeating-linear-gradient(90deg, #7f4f24 0px, #9c6644 14px, #6f3e1b 28px);
      box-shadow: inset 0 0 25px rgba(0,0,0,0.5), 0 8px 24px rgba(0,0,0,0.25);
      border: 3px solid #582f0e;
      transition: transform 2.2s cubic-bezier(0.65, 0, 0.15, 1);
      transform-style: preserve-3d;
    }
    .leaf.left {
      transform-origin: left center;
      border-radius: 260px 0 0 12px;
      border-right: 1.5px solid rgba(0,0,0,0.3);
    }
    .leaf.right {
      transform-origin: right center;
      border-radius: 0 260px 12px 0;
      border-left: 1.5px solid rgba(0,0,0,0.3);
    }

    .leaf::after {
      content: '';
      position: absolute;
      inset: 16px;
      border: 2px dashed rgba(255, 224, 130, 0.45);
      border-radius: 240px 0 0 8px;
    }
    .leaf.right::after { border-radius: 0 240px 8px 0; }

    .stage.opened .leaf.left { transform: rotateY(-115deg); }
    .stage.opened .leaf.right { transform: rotateY(115deg); }

    /* Clasp */
    .clasp {
      position: absolute;
      top: 52%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 64px;
      height: 64px;
      z-index: 10;
      cursor: pointer;
      transition: opacity 0.6s ease, transform 0.8s ease;
      animation: float-clasp 2s ease-in-out infinite alternate;
    }
    @keyframes float-clasp {
      from { transform: translate(-50%, -50%) scale(1); }
      to { transform: translate(-50%, -54%) scale(1.05); }
    }
    .clasp svg {
      width: 100%;
      height: 100%;
      filter: drop-shadow(0 0 14px rgba(255, 224, 130, 0.9));
    }
    .stage.opened .clasp {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.2);
      pointer-events: none !important;
    }

    /* Garland */
    .garland {
      position: absolute;
      top: -24px;
      left: 50%;
      transform: translateX(-50%);
      width: 106%;
      height: 60px;
      z-index: 8;
      pointer-events: none;
      transition: opacity 1s ease 0.5s;
    }
    .stage.opened .garland { opacity: 0; }

    /* Center Content — Brought to top layer */
    .content {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: min(85vw, 540px);
      text-align: center;
      z-index: 30; /* Elevated above all gate layers */
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      pointer-events: auto;
    }

    .tagline {
      font-size: clamp(0.95rem, 2.5vw, 1.2rem);
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--rose-deep);
      font-family: 'Quicksand', sans-serif;
      margin-bottom: 12px;
      opacity: 0;
    }

    .message {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.3;
      color: var(--text-ink);
      text-shadow: 0 4px 18px rgba(255, 255, 255, 0.7);
      opacity: 0;
    }
    .message span { color: var(--rose-deep); font-weight: 700; }

    .stage.opened .tagline {
      animation: fadeInUp 1.2s ease forwards 1.8s;
    }
    .stage.opened .message {
      animation: fadeInUp 1.4s ease forwards 2.2s;
    }

    .cta {
      margin-top: 36px;
      opacity: 0;
      position: relative;
      z-index: 40;
    }
    .stage.opened .cta {
      animation: fadeInUp 1s ease forwards 3s;
    }

    .cta-btn {
      font-family: 'Quicksand', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
      background: linear-gradient(135deg, #f48fb1, #e57373, #d4af37);
      border: none;
      padding: 16px 44px;
      border-radius: 999px;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(229, 115, 115, 0.45);
      transition: all 0.35s ease;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      position: relative;
      z-index: 50;
      pointer-events: auto !important;
      user-select: none;
    }
    .cta-btn:hover {
      transform: translateY(-4px) scale(1.03);
      box-shadow: 0 14px 30px rgba(229, 115, 115, 0.6);
    }
    .cta-btn:active {
      transform: translateY(-1px) scale(0.99);
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(22px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 600px) {
      .gate-wrap { width: 90vw; height: 75vh; }
      .arch-frame { inset: -8px; border-width: 5px; }
      .leaf::after { inset: 10px; }
    }
  </style>
</head>
<body>

<div class="stage" id="stage">
  <div class="warmth"></div>
  <div class="bokeh" id="bokeh"></div>
  <div class="hearts-field" id="heartsField"></div>

  <!-- Decorative Gateway -->
  <div class="gate-wrap">
    <div class="arch-frame"></div>
    <div class="gate">
      <div class="leaf left"></div>
      <div class="leaf right"></div>

      <div class="clasp" id="clasp" title="Click to open">
        <svg viewBox="0 0 100 100">
          <path d="M50 86 C20 62, 5 44, 5 26 C5 12, 19 3, 33 8 C42 12, 48 18, 50 25 C52 18, 58 12, 67 8 C81 3, 95 12, 95 26 C95 44, 80 62, 50 86 Z"
                fill="url(#goldGrad)" stroke="#f5d77f" stroke-width="3"/>
          <defs>
            <linearGradient id="goldGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ffe082"/>
              <stop offset="50%" stop-color="#d4af37"/>
              <stop offset="100%" stop-color="#aa7c11"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Garland SVG -->
      <div class="garland">
        <svg viewBox="0 0 600 60" preserveAspectRatio="none" style="width:100%; height:100%;">
          <path d="M 0 10 Q 150 45, 300 20 Q 450 -5, 600 15" fill="none" stroke="#688a50" stroke-width="4"/>
          <g fill="#e57373">
            <circle cx="100" cy="22" r="7"/>
            <circle cx="200" cy="25" r="8"/>
            <circle cx="300" cy="18" r="9"/>
            <circle cx="410" cy="12" r="8"/>
            <circle cx="510" cy="22" r="7"/>
          </g>
          <g fill="#ffe082">
            <circle cx="100" cy="22" r="3"/>
            <circle cx="200" cy="25" r="3.5"/>
            <circle cx="300" cy="18" r="3.5"/>
            <circle cx="410" cy="12" r="3"/>
            <circle cx="510" cy="22" r="3"/>
          </g>
        </svg>
      </div>
    </div>
  </div>

  <!-- Content Revealed Inside -->
  <div class="content">
    <p class="tagline">A special surprise</p>
    <h1 class="message">Hey <span>Beautiful</span>,<br>someone loves you endlessly... ✨</h1>
    <div class="cta">
      <button class="cta-btn" id="openLetterBtn" type="button">Step Inside 💌</button>
    </div>
  </div>
</div>

<script>
  const stage = document.getElementById('stage');
  const clasp = document.getElementById('clasp');
  const openLetterBtn = document.getElementById('openLetterBtn');

  // Bokeh Background Generator
  const bokehContainer = document.getElementById('bokeh');
  for (let i = 0; i < 16; i++) {
    const bubble = document.createElement('span');
    const size = 20 + Math.random() * 55;
    bubble.style.width = `${size}px`;
    bubble.style.height = `${size}px`;
    bubble.style.left = `${Math.random() * 100}%`;
    bubble.style.top = `${Math.random() * 100}%`;
    bubble.style.animationDelay = `${Math.random() * 5}s`;
    bubble.style.animationDuration = `${6 + Math.random() * 6}s`;
    bokehContainer.appendChild(bubble);
  }

  // Floating Hearts
  const heartsField = document.getElementById('heartsField');
  const icons = ['🌸', '💖', '✨', '💕', '🌷'];
  function spawnHeart() {
    const el = document.createElement('span');
    el.className = 'heart-particle';
    el.textContent = icons[Math.floor(Math.random() * icons.length)];
    el.style.left = `${Math.random() * 96}%`;
    el.style.fontSize = `${0.9 + Math.random() * 1.2}rem`;
    el.style.animationDuration = `${6 + Math.random() * 5}s`;
    heartsField.appendChild(el);
    setTimeout(() => el.remove(), 11000);
  }
  for (let i = 0; i < 7; i++) setTimeout(spawnHeart, i * 400);
  setInterval(spawnHeart, 750);

  // Gate Opener
  function openGate() {
    stage.classList.add('opened');
  }

  window.addEventListener('load', () => {
    setTimeout(openGate, 1200);
  });
  clasp.addEventListener('click', openGate);

  // Direct Button Redirection
  openLetterBtn.addEventListener('click', (e) => {
    e.preventDefault();
    window.location.href = '/message';
  });
</script>
</body>
</html>