      </section>

      <button class="replay-btn" id="replayBtn">Replay Celebration</button>
    </div>
  </div>
</main>

<div class="lightbox-modal" id="lightboxModal" role="dialog" aria-modal="true">
  <button class="lightbox-btn lightbox-close" id="lightboxClose" aria-label="Close image">✕</button>
  <button class="lightbox-btn lightbox-prev" id="lightboxPrev" aria-label="Previous image">‹</button>
  <button class="lightbox-btn lightbox-next" id="lightboxNext" aria-label="Next image">›</button>
  
  <div class="lightbox-content">
    <div class="lightbox-img-wrap">
      <img src="" alt="Full Screen Memory" class="lightbox-img" id="lightboxImg">
      <p class="lightbox-caption" id="lightboxCaption"></p>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
<script>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const YOUTUBE_VIDEO_ID = "wkTMatDWSK0"; // Starts at 31s

/* Twinkling Stars */
(function buildStars(){
  const field = document.getElementById('starsField');
  for (let i = 0; i < 14; i++) {
    const s = document.createElement('span');
    s.className = 'star';
    s.textContent = '✦';
    s.style.left = Math.random() * 100 + 'vw';
    s.style.top = Math.random() * 100 + 'vh';
    s.style.fontSize = (8 + Math.random() * 10) + 'px';
    s.style.animationDelay = (Math.random() * 3.4) + 's';
    field.appendChild(s);
  }
})();

function confettiAt(el, opts = {}) {
  if (!window.confetti || reduceMotion) return;
  const r = el.getBoundingClientRect();
  const x = (r.left + r.width / 2) / window.innerWidth;
  const y = (r.top + r.height / 2) / window.innerHeight;
  confetti(Object.assign({
    particleCount: 26, spread: 55, startVelocity: 28, origin: { x, y },
    colors: ['#ff5f9e', '#22c3b6', '#8f7dfb', '#ffc93c', '#0033a0']
  }, opts));
}

/* Audio Player */
const musicBtn = document.getElementById('musicBtn');
let playerStarted = false;
let musicMuted = false;

function ensurePlayer(){
  if (playerStarted) return;
  playerStarted = true;
  const wrap = document.getElementById('ytWrap');
  const iframe = document.createElement('iframe');
  iframe.id = 'ytPlayer';
  iframe.src = `https://www.youtube.com/embed/${YOUTUBE_VIDEO_ID}?autoplay=1&mute=0&start=31&loop=1&playlist=${YOUTUBE_VIDEO_ID}&controls=0&enablejsapi=1&playsinline=1`;
  iframe.allow = 'autoplay; encrypted-media';
  wrap.appendChild(iframe);
  musicBtn.classList.add('playing');
}

function ytCommand(func){
  const iframe = document.getElementById('ytPlayer');
  if (!iframe || !iframe.contentWindow) return;
  iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func, args: [] }), '*');
}

function updateMusicBtn(){
  musicBtn.textContent = musicMuted ? '🔇' : '🔊';
  musicBtn.setAttribute('aria-label', musicMuted ? 'Unmute music' : 'Mute music');
}

musicBtn.addEventListener('click', () => {
  if (!playerStarted) { ensurePlayer(); return; }
  musicMuted = !musicMuted;
  ytCommand(musicMuted ? 'mute' : 'unMute');
  musicBtn.classList.toggle('playing', !musicMuted);
  updateMusicBtn();
});

/* Candle */
const candleBtn = document.getElementById('candleBtn');
const candleHint = document.getElementById('candleHint');
const revealBlock = document.getElementById('revealBlock');

candleBtn.addEventListener('click', () => {
  ensurePlayer();
  if (candleBtn.classList.contains('blown')) return;
  candleBtn.classList.add('blown');
  candleHint.classList.add('hide');
  confettiAt(candleBtn, { particleCount: 65, spread: 80 });
  setTimeout(() => revealBlock.classList.add('show'), 350);
});

/* Gift Boxes */
const giftBtns = document.querySelectorAll('.gift-btn');
const giftHint = document.getElementById('giftHint');
const notes = document.getElementById('notes');
const finalCard = document.getElementById('finalCard');
let openedCount = 0;

giftBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    if (btn.classList.contains('opened')) return;
    btn.classList.add('opened');
    openedCount++;
    confettiAt(btn, { particleCount: 22, spread: 55, scalar: .75 });

    const line = document.createElement('p');
    line.className = 'note-line';
    line.textContent = btn.dataset.msg;
    notes.appendChild(line);

    const left = giftBtns.length - openedCount;
    giftHint.textContent = left > 0 ? `${left} gift${left === 1 ? '' : 's'} left` : 'All gifts opened! 🎁';

    if (openedCount === giftBtns.length) {
      setTimeout(() => {
        finalCard.style.display = 'block';
        if (!reduceMotion) {
          confetti({ 
            particleCount: 140, spread: 100, origin: { y: 0.5 },
            colors: ['#ff5f9e', '#22c3b6', '#8f7dfb', '#ffc93c', '#0033a0'] 
          });
        }
        finalCard.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      }, 500);
    }
  });
});

/* =====================================================================
   LIGHTBOX MODAL LOGIC
   ===================================================================== */
const polaroids = document.querySelectorAll('.polaroid');
const lightboxModal = document.getElementById('lightboxModal');
const lightboxImg = document.getElementById('lightboxImg');
const lightboxCaption = document.getElementById('lightboxCaption');
const lightboxClose = document.getElementById('lightboxClose');
const lightboxPrev = document.getElementById('lightboxPrev');
const lightboxNext = document.getElementById('lightboxNext');
let currentImgIndex = 0;

const galleryData = Array.from(polaroids).map(p => ({
  src: p.querySelector('img').src,
  caption: p.querySelector('.polaroid-caption').textContent
}));

function openLightbox(index) {
  currentImgIndex = index;
  updateLightbox();
  lightboxModal.classList.add('active');
  document.body.style.overflow = 'hidden'; // prevent background scrolling
}

function updateLightbox() {
  const item = galleryData[currentImgIndex];
  lightboxImg.src = item.src;
  lightboxCaption.textContent = item.caption;
}

function closeLightbox() {
  lightboxModal.classList.remove('active');
  document.body.style.overflow = '';
}

function nextLightbox() {
  currentImgIndex = (currentImgIndex + 1) % galleryData.length;
  updateLightbox();
}

function prevLightbox() {
  currentImgIndex = (currentImgIndex - 1 + galleryData.length) % galleryData.length;
  updateLightbox();
}

polaroids.forEach((card, index) => {
  card.addEventListener('click', () => openLightbox(index));
  card.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      openLightbox(index);
    }
  });
});

lightboxClose.addEventListener('click', closeLightbox);
lightboxNext.addEventListener('click', nextLightbox);
lightboxPrev.addEventListener('click', prevLightbox);

// Close on backdrop click
lightboxModal.addEventListener('click', (e) => {
  if (e.target === lightboxModal) closeLightbox();
});

// Keyboard Navigation
window.addEventListener('keydown', (e) => {
  if (!lightboxModal.classList.contains('active')) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowRight') nextLightbox();
  if (e.key === 'ArrowLeft') prevLightbox();
});

/* Replay */
document.getElementById('replayBtn').addEventListener('click', () => {
  candleBtn.classList.remove('blown');
  candleHint.classList.remove('hide');
  revealBlock.classList.remove('show');
  giftBtns.forEach(b => b.classList.remove('opened'));
  notes.innerHTML = '';
  finalCard.style.display = 'none';
  openedCount = 0;
  giftHint.textContent = '4 gifts left to open';
  window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
});
</script>

</body>
</html>