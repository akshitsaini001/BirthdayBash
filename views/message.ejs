<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>A Letter For You 💌</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Cormorant+Garamond:ital,wght@0,500;1,400;1,600&family=Quicksand:wght@600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 50%, #f48fb1 100%);
      font-family: 'Cormorant Garamond', serif;
      overflow-x: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 30px 16px;
    }

    /* Falling Petals Background */
    .petals-container {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }
    .petal {
      position: absolute;
      top: -40px;
      font-size: 1.4rem;
      opacity: 0;
      animation: fallPetal linear infinite;
    }
    @keyframes fallPetal {
      0% { transform: translateY(0) rotate(0deg) translateX(0); opacity: 0; }
      15% { opacity: 0.9; }
      90% { opacity: 0.8; }
      100% { transform: translateY(105vh) rotate(360deg) translateX(50px); opacity: 0; }
    }

    /* Parchment Card */
    .letter-container {
      position: relative;
      z-index: 5;
      width: min(92vw, 650px);
      background: #fdfbf7;
      border-radius: 18px;
      padding: clamp(28px, 5vw, 55px);
      box-shadow: 0 20px 60px rgba(136, 14, 79, 0.2), 0 0 0 1px rgba(212, 175, 55, 0.25);
      opacity: 0;
      transform: scale(0.85) translateY(30px);
      animation: letterReveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.8s;
    }
    @keyframes letterReveal {
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* Pinned Rose on Letter Top */
    .rose-seal {
      position: absolute;
      top: -28px;
      right: 36px;
      width: 58px;
      height: 58px;
      background: #ffffff;
      border-radius: 50%;
      box-shadow: 0 6px 16px rgba(0,0,0,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      border: 2px solid #f8bbd0;
      transform: rotate(15deg);
      animation: sealPulse 2.5s ease-in-out infinite;
    }
    @keyframes sealPulse {
      0%, 100% { transform: rotate(15deg) scale(1); }
      50% { transform: rotate(10deg) scale(1.08); }
    }

    .letter-header {
      font-family: 'Caveat', cursive;
      font-size: clamp(2rem, 4vw, 2.6rem);
      color: #ad1457;
      margin-bottom: 20px;
    }

    .letter-body {
      font-size: clamp(1.15rem, 2.8vw, 1.4rem);
      line-height: 1.7;
      color: #3e2723;
      min-height: 220px;
      white-space: pre-wrap;
      letter-spacing: 0.02em;
    }

    .cursor {
      display: inline-block;
      width: 2px;
      height: 1.2em;
      background-color: #ad1457;
      vertical-align: middle;
      margin-left: 2px;
      animation: blink 0.8s infinite;
    }
    @keyframes blink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0; }
    }

    .letter-footer {
      margin-top: 32px;
      text-align: right;
      font-family: 'Caveat', cursive;
      font-size: 1.8rem;
      color: #ad1457;
      opacity: 0;
      transition: opacity 1s ease;
    }

    .action-wrap {
      text-align: center;
      margin-top: 36px;
      opacity: 0;
      transform: translateY(12px);
      transition: all 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .action-wrap.show {
      opacity: 1;
      transform: translateY(0);
    }

    .next-btn {
      font-family: 'Quicksand', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      color: #fff;
      background: linear-gradient(135deg, #d81b60, #f06292);
      border: none;
      padding: 15px 42px;
      border-radius: 999px;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(216, 27, 96, 0.35);
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .next-btn:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 14px 28px rgba(216, 27, 96, 0.45);
    }
  </style>
</head>
<body>

  <div class="petals-container" id="petals"></div>

  <div class="letter-container">
    <div class="rose-seal" title="With all my love">🌹</div>
    <div class="letter-header">My Dearest Girl,</div>
    <div class="letter-body" id="typewriterText"></div><span class="cursor" id="cursor"></span>
    <div class="letter-footer" id="letterFooter">Forever & always yours Rakshit Deshwal ❤️</div>
    

    <div class="action-wrap" id="actionWrap">
      <a href="/gallery" class="next-btn">Our Memories 📸 ✨</a>
    </div>
  </div>

  <script>
    // Rose petal shower
    const petalsContainer = document.getElementById('petals');
    const petalShapes = ['🌸', '🌹', '✨', '🍃'];
    function createPetal() {
      const p = document.createElement('div');
      p.className = 'petal';
      p.textContent = petalShapes[Math.floor(Math.random() * petalShapes.length)];
      p.style.left = Math.random() * 100 + 'vw';
      p.style.animationDuration = (7 + Math.random() * 5) + 's';
      p.style.fontSize = (1 + Math.random() * 0.9) + 'rem';
      petalsContainer.appendChild(p);
      setTimeout(() => p.remove(), 12000);
    }
    setInterval(createPetal, 450);

    // Typing Animation
    const message = 
`Happy Birthday to the one who makes my world infinitely brighter!

Every smile you share, every laugh we hold, and every quiet moment with you is my favorite memory. You are pure magic, warmth, and grace, and today is all about celebrating the wonderful human you are.

I made this little space just to remind you how deeply you are adored. Ready to take a walk down our memory lane?`;

    const typewriterEl = document.getElementById('typewriterText');
    const cursor = document.getElementById('cursor');
    const footer = document.getElementById('letterFooter');
    const actionWrap = document.getElementById('actionWrap');

    let charIndex = 0;
    function type() {
      if (charIndex < message.length) {
        typewriterEl.textContent += message.charAt(charIndex);
        charIndex++;
        const delay = message.charAt(charIndex - 1) === '\n' ? 180 : 38;
        setTimeout(type, delay);
      } else {
        cursor.style.display = 'none';
        footer.style.opacity = '1';
        setTimeout(() => {
          actionWrap.classList.add('show');
        }, 600);
      }
    }

    // Start typing after letter opens
    setTimeout(type, 1600);
  </script>
</body>
</html>