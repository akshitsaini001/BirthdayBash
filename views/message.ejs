            </div>
            <figcaption class="polaroid-caption">Cognizant Ready 💼</figcaption>
          </figure>

          <figure class="polaroid" tabindex="0" data-index="1">
            <div class="polaroid-tape"></div>
            <div class="polaroid-img-box">
              <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&auto=format&fit=crop&q=80" alt="Best Smile">
            </div>
            <figcaption class="polaroid-caption">Best Smile 🌸</figcaption>
          </figure>

          <figure class="polaroid" tabindex="0" data-index="2">
            <div class="polaroid-tape"></div>
            <div class="polaroid-img-box">
              <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=800&auto=format&fit=crop&q=80" alt="Pure Vibes">
            </div>
            <figcaption class="polaroid-caption">Pure Vibes ✨</figcaption>
